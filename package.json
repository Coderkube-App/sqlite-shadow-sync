{
  "name": "sqlite-shadow-sync",
  "version": "1.0.0",
  "description": "Safe, zero-lock, automatic background shadow backups for SQLite in Node.js with WAL-safety, compression, and integrity-checks.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "node init && tsup src/index.ts --format cjs,esm --dts --minify --clean",
    "dev": "node init && tsup src/index.ts --format cjs,esm --watch --dts",
    "test": "vitest run"
  },
  "keywords": [
    "sqlite",
    "sqlite3",
    "backup",
    "shadow-copy",
    "wal-mode",
    "background-backup",
    "database-rotation",
    "zero-dependency",
    "integrity-check"
  ],
  "author": "Coderkube App",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2"
  },
  "peerDependencies": {
    "better-sqlite3": "^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "sqlite3": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderkube-App/sqlite-shadow-sync.git"
  },
  "bugs": {
    "url": "https://github.com/Coderkube-App/sqlite-shadow-sync/issues"
  },
  "homepage": "https://github.com/Coderkube-App/sqlite-shadow-sync#readme"
}
